{
  "name": "ecommerce-core",
  "description": "A monorepo for the core backend of E-commerce Application",
  "version": "0.0.1",
  "author": "Jefferson Pillejera <jefferson.pillejera@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ecore"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.4",
      "axios": ">=1.15.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "handlebars": ">=4.7.9",
      "minimatch@3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "serialize-javascript": ">=7.0.3",
      "@hono/node-server": ">=1.19.10",
      "flatted": ">=3.4.2",
      "socket.io-parser": ">=4.2.6",
      "effect": ">=3.20.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "path-to-regexp": ">=8.4.0",
      "defu": ">=6.1.5",
      "multer": ">=2.1.1",
      "lodash": ">=4.18.0"
    }
  },
  "devDependencies": {
    "@ecore/eslint-config": "workspace:*",
    "@ecore/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "turbo": "^2.6.3"
  }
}
